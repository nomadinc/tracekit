{
  "schema_version": "ws023.reporting-operations.v1",
  "source_commit": "e44b59c37873fd70d1a0154304edcdf8fd5eb684",
  "purpose": "WS-001 restricted staging reporting operation contract",
  "approval": "SOURCE_EXTRACT_ONLY_NOT_GRANT_AUTHORIZATION",
  "default_policy": "DENY",
  "transport": {
    "current": "UI scopedCoreGet / customer production repository use x-tk-secret privileged Core transport",
    "required": "signed scoped reporting transport with current membership and no privileged fallback",
    "status": "BLOCKED_NOT_CUT_OVER"
  },
  "operations": [
    {
      "id": "customer.list",
      "ui": [
        "GET /api/customers"
      ],
      "core": "GET /v1/customers",
      "permissions_all": [
        "customers.view"
      ],
      "kind": "core_computed",
      "relations": [
        "people",
        "person_identifiers",
        "journeys",
        "tracekit_customer_order_read_model",
        "journey_attribution_credits",
        "affiliate_commissions"
      ],
      "scope": [
        "workspace_id = authenticated organization",
        "order view additionally organization_id = workspace_id"
      ],
      "object_rules": [
        "resolved_person_id from retained evidence",
        "no heuristic identity joining"
      ],
      "projection": "Customer Explorer listing; sensitive financial and PII fields must be projected/redacted",
      "status": "BLOCKED_PENDING_EXACT_QUERY_AND_PROJECTION_REVIEW"
    },
    {
      "id": "customer.detail",
      "ui": [
        "GET /api/customers/{customerId}"
      ],
      "core": "GET /v1/customers/{person_id}",
      "permissions_all": [
        "customers.view"
      ],
      "kind": "core_computed",
      "relations": [
        "people",
        "person_identifiers",
        "identity_resolution_events",
        "journeys",
        "tracekit_customer_order_read_model",
        "journey_attribution_credits",
        "affiliate_commissions",
        "work_items"
      ],
      "scope": [
        "workspace_id = authenticated organization",
        "person_id = requested person",
        "order view organization_id = workspace_id"
      ],
      "object_rules": [
        "person must exist in tenant",
        "work items filtered related_person_id"
      ],
      "projection": "Customer 360 and work-item summaries; apply financial and sensitive identity redaction",
      "status": "BLOCKED_PENDING_WORK_ITEM_COLUMNS_AND_PROJECTION_REVIEW"
    },
    {
      "id": "customer.journey.detail",
      "ui": [
        "GET /api/customers/{customerId}/journeys/{journeyId}"
      ],
      "core": "GET /v1/customers/{person_id}/journeys/{journey_id}",
      "permissions_all": [
        "customers.view"
      ],
      "kind": "core_computed",
      "relations": [
        "people",
        "journeys",
        "journey_events",
        "identity_resolution_events",
        "tracekit_customer_order_read_model",
        "person_identifiers",
        "journey_attribution_credits",
        "affiliate_commissions"
      ],
      "scope": [
        "workspace_id = authenticated organization",
        "journeys.person_id = requested person",
        "journeys.id = requested journey",
        "journey_events.journey_id = requested journey",
        "orders.resolved_person_id = requested person",
        "orders.organization_id = workspace_id"
      ],
      "object_rules": [
        "person and journey must match",
        "date-bounded order and identity events",
        "unresolved orders remain unresolved"
      ],
      "projection": "Bounded timeline, attribution, orders, commissions and identity evidence; financial redaction required",
      "status": "BLOCKED_PENDING_PROJECTION_AND_VIEW_RLS_REVIEW"
    },
    {
      "id": "customer.orders",
      "ui": [
        "GET /api/customer-orders"
      ],
      "core": "GET /v1/customer-orders",
      "permissions_all": [
        "orders.view"
      ],
      "kind": "core_computed",
      "relations": [
        "tracekit_customer_order_read_model"
      ],
      "scope": [
        "workspace_id = authenticated organization",
        "organization_id = workspace_id",
        "optional platform_order_id = order_id filter",
        "optional resolved_person_id = person_id filter"
      ],
      "object_rules": [
        "unresolved person remains null",
        "limit 1..100; offset >=0"
      ],
      "projection": "order plus resolved customer id and identity_state; gross_amount deleted unless BOTH financial permissions",
      "status": "BLOCKED_PENDING_RESTRICTED_VIEW_VERIFICATION"
    },
    {
      "id": "profit.summary",
      "ui": [
        "GET /api/profit/summary"
      ],
      "core": "GET /v1/profit/summary",
      "permissions_all": [
        "financials.view",
        "orders.view_financials"
      ],
      "kind": "core_computed",
      "relations": [
        "profit_daily_rollups"
      ],
      "scope": [
        "workspace_id = authenticated organization",
        "optional day >= from",
        "optional day <= to",
        "optional connector_id",
        "optional platform",
        "optional event_source",
        "optional currency"
      ],
      "object_rules": [
        "offer_id returns HTTP 422 before database access",
        "mixed or unidentified currency returns HTTP 422",
        "empty period data_available=false",
        "financial_status=operational_unreconciled"
      ],
      "projection": "Summed ProfitTotals, qualified currency, data_available, status; Cache-Control no-store",
      "status": "BLOCKED_PENDING_RESTRICTED_RUNTIME_AUTHORITY"
    },
    {
      "id": "profit.summary.executive_expansion",
      "ui": [
        "GET /api/profit/summary?include_executive_performance=1"
      ],
      "core": "GET /v1/profit/summary?include_executive_performance=1",
      "permissions_all": [
        "financials.view",
        "orders.view_financials"
      ],
      "kind": "core_computed",
      "relations": [],
      "scope": [
        "authenticated workspace; additional source filters require separate proof"
      ],
      "projection": "ExecutivePerformancePayload",
      "status": "BLOCKED_UNVERIFIED_ADDITIONAL_READ_GRAPH"
    },
    {
      "id": "profit.summary.offer",
      "ui": [
        "GET /api/profit/summary?offer_id=..."
      ],
      "core": "GET /v1/profit/summary?offer_id=...",
      "permissions_all": [
        "financials.view",
        "orders.view_financials"
      ],
      "kind": "unsupported",
      "relations": [],
      "scope": [
        "no database read permitted"
      ],
      "projection": "HTTP 422 profit_offer_identity_unresolved",
      "status": "BLOCKED_MISSING_VERIFIED_FINANCIAL_TO_OFFER_IDENTITY"
    }
  ],
