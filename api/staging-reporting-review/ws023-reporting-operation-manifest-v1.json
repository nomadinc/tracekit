  "work_item_dependency": {
    "function": "getWorkItemsForPerson",
    "source": "api/src/work-items.ts",
    "relation": "work_items",
    "select_constant": "WORK_ITEM_SELECT",
    "predicates": [
      "workspace_id = authenticated organization",
      "related_person_id = person_id",
      "status in (open, acknowledged, in_progress) OR status = resolved"
    ],
    "ordering": [
      "updated_at desc",
      "resolved_at desc"
    ],
    "limits": [
      "open_limit default 10",
      "resolved_limit default 5"
    ],
    "status": "BLOCKED_EXACT_COLUMNS_NOT_YET_EXTRACTED"
  },
  "joins": {
    "customer_orders": "read model resolved_person_id to people.id, only when deterministic; order view also organization_id=workspace_id",
    "journey": "journeys.person_id to people.id, journey_events.journey_id to journeys.id, credits/commissions by exact journey_id and event IDs",
    "profit_offer": "NO VERIFIED JOIN; DO NOT ENABLE"
  },
