# Commas Phase 1 discovery only. Never commit real credentials.
COMMAS_API_KEY_SMALL_ACCOUNT=replace-with-local-small-account-read-only-key
COMMAS_API_KEY_MAIN_ACCOUNT=replace-with-local-main-account-read-only-key
COMMAS_BASE_URL=https://www.fanbasis.com
COMMAS_DISCOVERY_DEBUG=false
COMMAS_REFUND_SCAN_PAGE_CAP=10
COMMAS_IDENTIFIER_SCAN_PAGE_CAP=5

# Production-intelligence capability controls (server-only, disabled by default).
TRACEKIT_PRODUCTION_WORKER_HOST=cloudflare_worker_queue
TRACEKIT_COMMERCE_SCHEDULER_ENABLED=false
TRACEKIT_COMMERCE_KILL_SWITCH=disabled
TRACEKIT_TKID_INGESTION_ENABLED=false
TRACEKIT_TKID_HANDOFF_KEY_REF=replace-with-server-secret-reference
TRACEKIT_TKID_ABUSE_ADAPTER=supabase_fixed_window_v1
TRACEKIT_TKID_ERASURE_EXECUTOR_ENABLED=false
TRACEKIT_TKID_RELAY_ENABLED=false
TRACEKIT_TKID_RELAY_ORIGIN=http://localhost:8787
TRACEKIT_TKID_RETENTION_POLICY_REF=approval-required
TRACEKIT_OPERATIONAL_ALERT_DESTINATION_REF=configuration-required
