# WorkOS AuthKit (server-only except the documented public redirect URI)
WORKOS_CLIENT_ID=client_example
WORKOS_API_KEY=sk_test_example
WORKOS_COOKIE_PASSWORD=replace-with-at-least-32-random-characters
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# Identity mode: workos for authenticated operation; development only for explicit local review.
TRACEKIT_IDENTITY_MODE=development
TRACEKIT_ENABLE_DEV_IDENTITIES=true

# Existing Supabase persistence (service-role key is server-only)
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key

# Commerce credential envelope encryption (server-only AES-256-GCM key material).
# Supply a base64 encoding of exactly 32 random bytes; never use this placeholder.
COMMERCE_CREDENTIALS_ENC_KEY=replace-with-base64-encoded-32-byte-key
COMMERCE_CREDENTIALS_KEY_ID=local-review-key
COMMERCE_CREDENTIALS_ENCRYPTION_VERSION=1

# Live-data proxies remain blocked until server authorization is complete.
TRACEKIT_REAL_DATA_ENABLED=false

# Phase 2.8 production-intelligence controls. All capabilities deploy disabled.
# These are server-only: never prefix them with NEXT_PUBLIC_.
TRACEKIT_PRODUCTION_WORKER_HOST=cloudflare_worker_queue
TRACEKIT_COMMERCE_SCHEDULER_ENABLED=false
TRACEKIT_COMMERCE_KILL_SWITCH=disabled
TRACEKIT_COMMERCE_OVERLAP_CRON=*/15 * * * *
TRACEKIT_COMMERCE_DEEP_CRON=0 3 * * 0
TRACEKIT_INVESTIGATION_CANDIDATE_CRON=5 * * * *
TRACEKIT_INVESTIGATION_REFRESH_CRON=10 * * * *
TRACEKIT_COMMAS_QUOTA_MINIMUM_REMAINING=1000
TRACEKIT_COMMAS_DEEP_REQUEST_BUDGET=800
TRACEKIT_COMMERCE_EVIDENCE_BUCKET=commerce-evidence
TRACEKIT_TKID_INGESTION_ENABLED=false
TRACEKIT_TKID_SDK_VERSION=1.0.0
TRACEKIT_TKID_HANDOFF_KEY_REF=replace-with-server-secret-reference
TRACEKIT_TKID_ABUSE_ADAPTER=supabase_fixed_window_v1
TRACEKIT_TKID_ERASURE_EXECUTOR_ENABLED=false
TRACEKIT_TKID_RETENTION_POLICY=approval-required
TRACEKIT_TKID_ERASURE_POLICY=approval-required
TRACEKIT_TKID_CONSENT_MODE=approval-required
TRACEKIT_OPERATIONAL_ALERT_DESTINATION_REF=configuration-required
