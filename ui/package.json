{
  "name": "tracekit-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/next-lifecycle.mjs dev",
    "lint": "next lint",
    "test": "tsx --test tests/*.test.ts",
    "build": "node scripts/next-lifecycle.mjs build",
    "start": "node scripts/next-lifecycle.mjs start",
    "review:check": "node scripts/next-lifecycle.mjs check",
    "prove:commas-evidence": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs scripts/prove-commerce-evidence.ts --confirm-bounded-live-proof",
    "validate:commas-bounded": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs scripts/run-commas-bounded-validation.ts",
    "discover:commas-dispute-contract": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs scripts/run-commas-dispute-contract-discovery.ts",
    "inspect:commas-webhooks": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs scripts/inspect-commas-webhooks.ts",
    "create:commas-dispute-webhook": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs scripts/create-commas-dispute-webhook.ts",
    "test:commas-dispute-webhook": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs scripts/test-commas-dispute-webhook.ts",
    "sync:commas-shadow": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs scripts/run-commas-shadow-sync.ts --confirm-full-shadow",
    "backfill:commas-history": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs scripts/run-commas-historical-batch.ts",
    "inspect:commas-historical-quota": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs scripts/inspect-commas-historical-quota.ts",
    "sync:commas-continuous": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs scripts/run-commas-continuous-sync.ts --confirm-bounded-continuous-proof",
    "backfill:commas-public-transactions": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs scripts/backfill-commas-public-transaction-identities.ts",
    "dispatch:commas-one-shot-shadow": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs scripts/run-one-shot-continuous-shadow.ts",
    "probe:commas-quota": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs scripts/probe-commas-quota.ts",
    "import:commas-disputes": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs scripts/import-commas-historical-disputes.ts --confirm-historical-import",
    "preview:commas-disputes": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs scripts/import-commas-historical-disputes.ts --confirm-historical-import --preview",
    "import:everflow-investigation": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs scripts/import-everflow-investigation.ts --confirm-protected-import",
    "materialize:accufy-investigation": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs scripts/materialize-accufy-investigation.ts",
    "materialize:oto2-child-investigation": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs scripts/materialize-oto2-child-investigation.ts"
  },
  "dependencies": {
    "@workos-inc/authkit-nextjs": "^4.3.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "fast-csv": "^4.3.6",
    "lucide-react": "^0.461.0",
    "next": "15.5.23",
    "next-themes": "^0.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.6.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.23",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5"
  }
}
