diff --git a/ui/lib/chargebacks/detail-request.ts b/ui/lib/chargebacks/detail-request.ts
new file mode 100644
index 00000000..c6e9b198
--- /dev/null
+++ b/ui/lib/chargebacks/detail-request.ts
@@ -0,0 +1,36 @@
+export function createDetailRequestCoordinator<T>(
+  load: (id: string) => Promise<T>,
+  publish: (value: T | null) => void
+) {
+  let generation = 0;
+
+  return {
+    select(id: string | null): Promise<void> {
+      const current = ++generation;
+      publish(null);
+
+      if (id === null) return Promise.resolve();
+
+      let request: Promise<T>;
+
+      try {
+        request = load(id);
+      } catch {
+        return Promise.resolve();
+      }
+
+      return request.then(
+        value => {
+          if (current === generation) publish(value);
+        },
+        () => {
+          if (current === generation) publish(null);
+        }
+      );
+    },
+
+    dispose() {
+      ++generation;
+    }
+  };
+}
diff --git a/ui/lib/chargebacks/format-currency.ts b/ui/lib/chargebacks/format-currency.ts
new file mode 100644
index 00000000..3c87fe5e
--- /dev/null
+++ b/ui/lib/chargebacks/format-currency.ts
@@ -0,0 +1,34 @@
+export function formatDisputeAmount(
+  amount: number | null | undefined,
+  currency: string | null | undefined,
+  currencySource: string | null | undefined
+): string {
+  if (amount == null || !Number.isFinite(amount)) return "—";
+
+  const code = typeof currency === "string"
+    ? currency.trim().toUpperCase()
+    : "";
+
+  const approvedSources = new Set([
+    "provider_payload.currency",
+    "provider_payload.fee_currency",
+    "workbook.Currency",
+    "workbook.Fee Currency",
+  ]);
+
+  if (!currencySource || !approvedSources.has(currencySource) || !/^[A-Z]{3}$/.test(code)) {
+    return `${amount.toLocaleString("en-US", {
+      minimumFractionDigits: 2,
+      maximumFractionDigits: 2,
+    })} (currency unknown)`;
+  }
+
+  try {
+    return new Intl.NumberFormat("en-US", {
+      style: "currency",
+      currency: code,
+    }).format(amount);
+  } catch {
+    return `${amount.toFixed(2)} (currency unknown)`;
+  }
+}
