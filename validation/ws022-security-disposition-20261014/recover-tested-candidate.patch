index 00000000..ea1e95d3
--- /dev/null
+++ b/ui/tests/chargeback-currency-formatting.test.ts
@@ -0,0 +1,46 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { readFileSync } from "node:fs";
+import { formatDisputeAmount } from "../lib/chargebacks/format-currency";
+
+test("principal and fee retain independent currencies", () => {
+  assert.match(
+    formatDisputeAmount(100, "EUR", "provider_payload.currency"),
+    /€100\.00/
+  );
+  assert.match(
+    formatDisputeAmount(5, "GBP", "provider_payload.fee_currency"),
+    /£5\.00/
+  );
+});
+
+test("unknown currency never defaults to USD", () => {
+  assert.equal(
+    formatDisputeAmount(100, null, null),
+    "100.00 (currency unknown)"
+  );
+  assert.equal(
+    formatDisputeAmount(5, "USD", null),
+    "5.00 (currency unknown)"
+  );
+});
+
+test("zero values and missing amounts remain distinct", () => {
+  assert.equal(
+    formatDisputeAmount(0, null, null),
+    "0.00 (currency unknown)"
+  );
+  assert.equal(formatDisputeAmount(null, "USD", "provider_payload.currency"), "—");
+});
+
+test("detail currency null does not fall back to list currency", () => {
+  const source = readFileSync(
+    new URL("../components/chargebacks/chargeback-review-workspace.tsx", import.meta.url),
+    "utf8"
+  );
+
+  assert.match(source, /detail \? detail\.currency : selected\.currency/);
+  assert.match(source, /detail \? detail\.feeCurrency : selected\.feeCurrency/);
+  assert.doesNotMatch(source, /detail\?\.currency\?\?selected\.currency/);
+  assert.doesNotMatch(source, /currency:"USD"/);
+});
diff --git a/ui/tests/chargeback-detail-request.test.ts b/ui/tests/chargeback-detail-request.test.ts
new file mode 100644
index 00000000..73354dfe
--- /dev/null
+++ b/ui/tests/chargeback-detail-request.test.ts
@@ -0,0 +1,102 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { createDetailRequestCoordinator } from "../lib/chargebacks/detail-request";
+
+function deferred<T>() {
+  let resolve!: (value: T) => void;
+  let reject!: (reason: Error) => void;
+
+  const promise = new Promise<T>((res, rej) => {
+    resolve = res;
+    reject = rej;
+  });
+
+  return { promise, resolve, reject };
+}
+
+test("late A response cannot overwrite selected B", async () => {
+  const a = deferred<string>();
+  const b = deferred<string>();
+  const displayed: Array<string | null> = [];
+
+  const coordinator = createDetailRequestCoordinator(
+    id => id === "A" ? a.promise : b.promise,
+    value => displayed.push(value)
+  );
+
+  const first = coordinator.select("A");
+  const second = coordinator.select("B");
+
+  await Promise.resolve();
+  b.resolve("B");
+  await second;
+  a.resolve("A");
+  await first;
+
+  assert.equal(displayed.at(-1), "B");
+  assert.ok(!displayed.includes("A"));
+});
+
+test("closing prevents late detail from returning", async () => {
+  const pending = deferred<string>();
+  const displayed: Array<string | null> = [];
+
+  const coordinator = createDetailRequestCoordinator(
+    () => pending.promise,
+    value => displayed.push(value)
+  );
+
+  const first = coordinator.select("A");
+  await Promise.resolve();
+  await coordinator.select(null);
+
+  pending.resolve("A");
+  await first;
+
+  assert.equal(displayed.at(-1), null);
+  assert.ok(!displayed.includes("A"));
+});
+
+test("late A rejection cannot clear B", async () => {
+  const a = deferred<string>();
+  const b = deferred<string>();
+  const displayed: Array<string | null> = [];
+
+  const coordinator = createDetailRequestCoordinator(
+    id => id === "A" ? a.promise : b.promise,
+    value => displayed.push(value)
+  );
+
+  const first = coordinator.select("A");
+  const second = coordinator.select("B");
+
+  await Promise.resolve();
+  b.resolve("B");
+  await second;
+
+  a.reject(new Error("A failed"));
+  await first;
+
+  assert.equal(displayed.at(-1), "B");
+});
+
+test("selection change immediately clears previous detail", async () => {
+  const pending = deferred<string>();
+  const displayed: Array<string | null> = [];
+
+  const coordinator = createDetailRequestCoordinator(
+    () => pending.promise,
+    value => displayed.push(value)
+  );
+
+  const first = coordinator.select("A");
+  await Promise.resolve();
+  pending.resolve("A");
+  await first;
+
+  const second = coordinator.select("B");
+  assert.equal(displayed.at(-1), null);
+
+  coordinator.dispose();
+  await second;
+});
