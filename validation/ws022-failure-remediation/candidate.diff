@@ -0,0 +1,14 @@
+import { NextResponse } from "next/server";
+import { resolveApplicationSession } from "@/lib/identity/application-session";
+import { getMetaConnectionPresentation } from "@/lib/integrations/meta-connection";
+export const dynamic = "force-dynamic";
+export async function GET() {
+  const headers = { "Cache-Control": "no-store" };
+  try {
+    const resolution = await resolveApplicationSession();
+    if (resolution.kind !== "authenticated" || !resolution.session.activeOrganization || !resolution.session.effectivePermissions.includes("connectors.manage")) return NextResponse.json({ok:false,code:"resource_unavailable"},{status:404,headers});
+    const rows = await getMetaConnectionPresentation(resolution.session);
+    const connections = rows.map(row => ({connectionId:row.connectionId,displayName:row.displayName,status:row.status,reauthorizationRequired:row.reauthorizationRequired,selectedAccountCount:row.selectedAccountCount,accounts:row.accounts.map(account=>({id:account.id,externalId:account.externalId,label:account.label,currency:account.currency,timezoneName:account.timezoneName,status:account.status,selectedForSync:account.selectedForSync}))}));
+    return NextResponse.json({ok:true,connections,syncEnabled:false},{headers});
+  } catch { return NextResponse.json({ok:false,code:"meta_status_unavailable"},{status:503,headers}); }
+}
diff --git a/ui/components/integrations/meta-integration-panel.tsx b/ui/components/integrations/meta-integration-panel.tsx
new file mode 100644
index 00000000..a1249219
--- /dev/null
+++ b/ui/components/integrations/meta-integration-panel.tsx
@@ -0,0 +1,15 @@
+"use client";
+import * as React from "react";
+type Account={id:string;externalId:string;label:string|null;currency:string|null;timezoneName:string|null;status:string;selectedForSync:boolean};
+type Connection={connectionId:string;displayName:string;status:string;accounts:Account[]};
+export function MetaIntegrationPanel(){
+ const [connections,setConnections]=React.useState<Connection[]>([]);
+ const [selected,setSelected]=React.useState<Record<string, Set<string>>>({});
+ const [error,setError]=React.useState<string|null>(null);
+ const [loading,setLoading]=React.useState(true);
+ const [saving,setSaving]=React.useState<string|null>(null);
+ const [notice,setNotice]=React.useState<string|null>(null);
+ React.useEffect(()=>{const controller=new AbortController();fetch("/v1/integrations/meta/status",{credentials:"same-origin",cache:"no-store",signal:controller.signal}).then(async response=>{if(!response.ok)throw Error();const data=await response.json();if(!data.ok||!Array.isArray(data.connections))throw Error();return data.connections as Connection[];}).then(rows=>{setConnections(rows);setSelected(Object.fromEntries(rows.map(row=>[row.connectionId,new Set(row.accounts.filter(account=>account.selectedForSync).map(account=>account.id))])));}).catch(()=>{if(!controller.signal.aborted)setError("Meta connections could not be loaded.");}).finally(()=>{if(!controller.signal.aborted)setLoading(false);});return()=>controller.abort();},[]);
+ async function save(connection:Connection){if(saving)return;setSaving(connection.connectionId);setNotice(null);setError(null);try{const response=await fetch("/v1/integrations/meta/accounts",{method:"POST",credentials:"same-origin",headers:{"Content-Type":"application/json"},body:JSON.stringify({connectionId:connection.connectionId,accountIds: Array.from(selected[connection.connectionId]||[])})});const result: {ok?:boolean;schedulesActivated?: boolean}=await response.json();if(!response.ok||!result.ok||result.schedulesActivated!==false)throw Error();setNotice("Account selection saved. Sync remains off.");}catch{setError("Account selection could not be saved. Reload to confirm the stored selection.");}finally{setSaving(null);}}
+ return <main className="space-y-4"><h1 className="text-2xl font-semibold">Meta Ads</h1><p>Read-only access only. TraceKit does not create or edit campaigns, ads, budgets, targeting, Pixels, or CAPI.</p><p><span>Sync:</span> Off — Account selection does not start syncing yet. No schedules are activated here.</p><a className="underline" href="/v1/integrations/meta/oauth/start">Connect Meta</a>{loading&&<p role="status">Loading connections…</p>}{error&&<p role="alert">{error}</p>}{notice&&<p role="status">{notice}</p>}{!loading&&!error&&!connections.length&&<p>No Meta connections are configured.</p>}{connections.map((connection)=><section key={connection.connectionId} className="rounded-lg border p-4 space-y-3"><h2 className="font-semibold">{connection.displayName}</h2><p>{connection.status}</p><button type="button" disabled={!!saving} onClick={()=>setSelected(prev=>({...prev,[connection.connectionId]:new Set(connection.accounts.filter(account=>["active","degraded"].includes(account.status)).map(account=>account.id))}))}>Select all available accounts</button>{connection.accounts.map(account=><label key={account.id} className="block"><input type="checkbox" disabled={!!saving||!["active","degraded"].includes(account.status)} checked={selected[connection.connectionId]?.has(account.id)||false} onChange={event=>{const checked=event.target.checked;setSelected(prev=>{const next=new Set(prev[connection.connectionId]);if(checked)next.add(account.id);else next.delete(account.id);return {...prev,[connection.connectionId]:next};});}}/> {account.label||account.externalId} — ID: {account.externalId} · Currency: {account.currency||"Unknown"} · Timezone: {account.timezoneName||"Unknown"} · {account.status}</label>)}<button type="button" disabled={!!saving||loading} onClick={()=>void save(connection)}>{saving===connection.connectionId?"Saving…":"Save account selection"}</button></section>)}</main>;
+}
