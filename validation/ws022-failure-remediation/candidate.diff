+test('Meta status denies missing authentication organization and permission before service access',async()=>{const route=await load('app/v1/integrations/meta/status/route.ts');for(const resolution of [{kind:'unauthenticated'},{kind:'authenticated',session:{...session,activeOrganization:null}},{kind:'authenticated',session:{...session,effectivePermissions:[]}}]){reset();ctx.__metaTest.resolution=resolution;const r=await route.GET();assert.equal(r.status,404);assert.equal(ctx.__metaTest.calls.length,0);assert.equal(r.headers.get('cache-control'),'no-store');}});
+test('Meta status allowlists fields and strips nested account metadata',async()=>{reset();ctx.__metaTest.rows=[{connectionId,displayName:'Synthetic',status:'connected',accounts:[{id:accountId,metadata:{private:'private-sentinel'},selectedForSync:true}],private:'private-sentinel'}];const route=await load('app/v1/integrations/meta/status/route.ts');const r=await route.GET();assert.equal(r.status,200);const data=await r.json();assert.equal(data.syncEnabled,false);assert.equal(data.connections[0].accounts[0].id,accountId);assert.ok(!JSON.stringify(data).includes('private-sentinel'));assert.equal(ctx.__metaTest.calls[0],session);});
+test('Meta account writes deny cross-origin and missing-origin requests before service access',async()=>{const route=await load('app/v1/integrations/meta/accounts/route.ts');for(const origin of [null,'https://foreign.invalid']){reset();assert.equal((await route.POST(req({connectionId,accountIds:[accountId]},origin))).status,403);assert.equal(ctx.__metaTest.calls.length,0);}});
+test('Meta account writes reject malformed IDs duplicates and oversized selections',async()=>{const route=await load('app/v1/integrations/meta/accounts/route.ts');for(const body of [null,{connectionId,accountIds:['provider-id']},{connectionId,accountIds:[accountId,accountId]},{connectionId:'bad',accountIds:[]},{connectionId,accountIds:Array(1001).fill(accountId)}]){reset();assert.equal((await route.POST(req(body))).status,400);assert.equal(ctx.__metaTest.calls.length,0);}reset();ctx.__metaTest.resolution={kind:'authenticated',session:{...session,effectivePermissions:[]}};assert.equal((await route.POST(req({connectionId,accountIds:[]}))).status,404);assert.equal(ctx.__metaTest.calls.length,0);});
+test('Meta selection uses session scope ignores caller organization and never enables schedules',async()=>{reset();ctx.__metaTest.accounts=[{selectedForSync:true}];const route=await load('app/v1/integrations/meta/accounts/route.ts');const r=await route.POST(req({connectionId,accountIds:[accountId],organizationId:'foreign'}));assert.equal(r.status,200);assert.deepEqual(await r.json(),{ok:true,selectedAccountCount:1,schedulesActivated:false});assert.equal(ctx.__metaTest.calls[0].session,session);assert.ok(!('organizationId' in ctx.__metaTest.calls[0]));reset();ctx.__metaTest.error=true;const failed=await route.POST(req({connectionId,accountIds:[]}));assert.equal(failed.status,503);assert.ok(!(await failed.text()).includes('private-sentinel'));});
