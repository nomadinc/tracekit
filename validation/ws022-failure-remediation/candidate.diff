+async function load(file:string){const mocks:Record<string,string>={
+'next/server':'export const NextResponse={json:(b,i)=>Response.json(b,i)};',
+'@/lib/identity/application-session':'export async function resolveApplicationSession(){return globalThis.__metaTest.resolution;}',
+'@/lib/integrations/meta-connection':'export async function getMetaConnectionPresentation(s){globalThis.__metaTest.calls.push(s);if(globalThis.__metaTest.error)throw Error("private-sentinel");return globalThis.__metaTest.rows;}export async function setMetaAccountSelection(i){globalThis.__metaTest.calls.push(i);if(globalThis.__metaTest.error)throw Error("private-sentinel");return globalThis.__metaTest.accounts;}'
+};const b=await build({entryPoints:[resolve(file)],bundle:true,write:false,platform:'node',format:'esm',plugins:[{name:'synthetic',setup(p){p.onResolve({filter:/.*/},a=>a.path in mocks?{path:a.path,namespace:'mock'}:undefined);p.onLoad({filter:/.*/,namespace:'mock'},a=>({contents:mocks[a.path],loader:'js'}));}}]});return import('data:text/javascript;base64,'+Buffer.from(b.outputFiles[0].text).toString('base64'));}
