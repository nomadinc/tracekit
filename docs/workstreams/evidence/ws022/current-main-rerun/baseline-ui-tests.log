          confirmationId: input.confirmationId,
          requestedAt: input.requestedAt,
        });
        if (!resolved)
          return {
            status: "rejected" as const,
            reason: "confirmation_reference_unavailable",
            executionAvailable: false as const,
            providerMutation: false as const,
